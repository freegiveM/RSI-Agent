DEPLOYMENT_MODE=local
APP_HOST=127.0.0.1
APP_PORT=8787
DATABASE_PATH=.rsi/reviews.db

GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_URL=https://api.github.com
REDIS_URL=redis://127.0.0.1:6379/0
# Optional split fields for remote deployments when REDIS_URL is empty.
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_STREAM=rsi:review-jobs
REDIS_CONSUMER_GROUP=rsi-workers

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TEMPERATURE=0
DEEPSEEK_THINKING=disabled
